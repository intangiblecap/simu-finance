{
  "name": "simu-finance",
  "version": "0.1.0",
  "private": true,
  "description": "Simulateur d'investissements en bourse (PWA sur Cloudflare Pages + D1)",
  "scripts": {
    "dev": "wrangler pages dev",
    "db:migrate:local": "wrangler d1 migrations apply simu-finance --local",
    "db:migrate:remote": "wrangler d1 migrations apply simu-finance --remote",
    "deploy": "wrangler pages deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.95.0"
  }
}
